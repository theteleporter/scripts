# GDrive Ingest Configuration
# Copy this file to .env and fill in your credentials

# ============================================
# Google Drive API Credentials
# ============================================
# Get these from: https://console.cloud.google.com/
# OAuth 2.0 setup required
CLIENT_ID=""
CLIENT_SECRET=""
REFRESH_TOKEN=""

# Note: ACCESS_TOKEN is auto-generated from REFRESH_TOKEN
# You don't need to set it manually

# ============================================
# Telegram API Credentials (Optional)
# ============================================
# Only needed if downloading from Telegram
# Get from: https://my.telegram.org (API development tools)
TELEGRAM_API_ID=""
TELEGRAM_API_HASH=""

# ============================================
# Script Configuration (Optional)
# ============================================
# Default folder for uploads (leave empty for interactive mode)
# DEFAULT_FOLDER="bckups"

# Debug mode (1 = enabled, 0 = disabled)
# DEBUG=0

# ============================================
# Notes
# ============================================
# - Never commit this file to git!
# - Added to .gitignore automatically
# - See docs/SETUP.md for detailed instructions
